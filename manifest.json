{
  "manifest_version": 3,
  "name": "YouTube 音量範圍鎖定器與真隨機 (YT Volume & True Shuffle)",
  "version": "1.2.0",
  "description": "YouTube 音量範圍鎖定器（25ms前瞻預判、太小自動調高、太大自動調低）與播放清單真隨機播放。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube 音量範圍鎖定器與真隨機"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/page_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
